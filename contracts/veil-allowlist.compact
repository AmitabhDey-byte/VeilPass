pragma language_version >= 0.23;

import CompactStandardLibrary;

// VeilPass: private allowlist access.
// The credential and its source stay in the caller's private state.
// Only the commitment and the validity result are written publicly.
witness private_credential_commitment(): Bytes<32>;
witness private_is_eligible(): Boolean;

export ledger allowlist_root: Bytes<32>;
export ledger verified_passes: Uint<64>;

export circuit register_allowlist_root(root: Bytes<32>): [] {
  allowlist_root = disclose(root);
}

export circuit prove_access(): [] {
  const eligible = private_is_eligible();
  assert(eligible);
  const commitment = private_credential_commitment();
  assert(commitment == allowlist_root);
  verified_passes = verified_passes + 1;
}
