# Optional: enables Gemini responses in the Veil assistant.
# Never commit a real key. Configure it in the local shell or hosting secrets.
GEMINI_API_KEY=

# Public runtime configuration for the wallet and deployed contract.
# Use 1AM on Preview or Preprod. Never put secrets here.
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=preprod
NEXT_PUBLIC_MIDNIGHT_WALLET=1am
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
